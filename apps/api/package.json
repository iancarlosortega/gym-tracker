{
  "name": "@gym/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "pnpm build && node --env-file-if-exists=.env dist/commands/migrate.command.js",
    "db:seed": "pnpm build && node --env-file-if-exists=.env dist/commands/seed-account.command.js"
  },
  "dependencies": {
    "@gym/contracts": "workspace:*",
    "@gym/domain": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@node-rs/argon2": "^2.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tldts": "^7.4.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
