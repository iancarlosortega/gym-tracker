{
  "name": "gym-tracker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "biome check . && ./scripts/check-no-barrels.sh && ./scripts/check-import-placement.sh",
    "format": "biome format --write .",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "db:migrate": "pnpm build:packages && pnpm --filter ./apps/api db:migrate",
    "db:seed": "pnpm build:packages && pnpm --filter ./apps/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
