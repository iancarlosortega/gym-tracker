# Deployment configuration for the compose stack. Copy to .env on the box.

# Both must be subdomains of one registrable domain, or the session cookie is
# treated as third-party and the API refuses to start.
GYM_DOMAIN=gym.example.com
API_DOMAIN=api.gym.example.com

# The shared Postgres gives this application its own database and role; the
# role can reach nothing else on the server.
POSTGRES_DB=gymtracker
POSTGRES_USER=gymtracker
POSTGRES_PASSWORD=
DATABASE_URL=postgres://gymtracker:@postgres:5432/gymtracker

SESSION_LIFETIME_DAYS=90

# Optional. Without them the application runs and says pocketed rest alerts
# are unavailable; the foreground countdown is unaffected.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
TRUST_PROXY=1
